# Included only in standalone diagnostic builds. Never changes vendor files.
execute_process(COMMAND python3 "${KAT_ROOT}/scripts/android/prepare-mtp-profile.py"
    "${KAT_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}" COMMAND_ERROR_IS_FATAL ANY)
function(kat_diagnostic_source target original replacement directory)
    get_target_property(sources ${target} SOURCES)
    set(patched "")
    foreach(source IN LISTS sources)
        if(source STREQUAL "${original}" OR source STREQUAL "${directory}/${original}")
            list(APPEND patched "${replacement}")
        elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
            list(APPEND patched "${source}")
        else()
            list(APPEND patched "${directory}/${source}")
        endif()
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${patched}")
    target_include_directories(${target} PRIVATE "${directory}")
endfunction()
kat_diagnostic_source(llama-common speculative.cpp "${CMAKE_CURRENT_BINARY_DIR}/speculative-profile.cpp" "${KAT_ROOT}/Dependencies/vendor/llama.cpp/common")
kat_diagnostic_source(server-context server-context.cpp "${CMAKE_CURRENT_BINARY_DIR}/server-context-profile.cpp" "${KAT_ROOT}/Dependencies/vendor/llama.cpp/tools/server")
