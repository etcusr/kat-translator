# Pinned offline media runtimes. Run scripts/android/setup-media.sh once.
set(KAT_MEDIA "${KAT_ROOT}/.build/android-media")
if(NOT EXISTS "${KAT_MEDIA}/whisper/libkat_whisper.so" OR NOT EXISTS "${KAT_MEDIA}/whisper-optimized/arm64-v8a/libkat_whisper_arm82.so" OR NOT EXISTS "${KAT_MEDIA}/jniLibs/arm64-v8a/libsherpa-onnx-c-api.so")
 message(FATAL_ERROR "Run scripts/android/setup-media.sh before building offline media")
endif()
add_library(kat_whisper SHARED IMPORTED)
set_target_properties(kat_whisper PROPERTIES IMPORTED_LOCATION "${KAT_MEDIA}/whisper/libkat_whisper.so")
add_library(kat_sherpa SHARED IMPORTED)
set_target_properties(kat_sherpa PROPERTIES IMPORTED_LOCATION "${KAT_MEDIA}/jniLibs/arm64-v8a/libsherpa-onnx-c-api.so")
add_library(kat_ort SHARED IMPORTED)
set_target_properties(kat_ort PROPERTIES IMPORTED_LOCATION "${KAT_MEDIA}/jniLibs/arm64-v8a/libonnxruntime.so")
add_library(kat_media SHARED "${CMAKE_CURRENT_LIST_DIR}/media_jni.cpp" "${KAT_ROOT}/shared/native/app/Speech/SpeechRuntime.c" "${KAT_ROOT}/shared/native/app/Privacy/InferencePrivacy.c" "${KAT_ROOT}/shared/native/app/ASR/WhisperCancellation.c" "${CMAKE_CURRENT_LIST_DIR}/ocr_scored.c")
target_include_directories(kat_media PRIVATE "${KAT_MEDIA}/include" "${KAT_ROOT}/shared/native/app")
target_link_libraries(kat_media PRIVATE kat_sherpa kat_ort kat_whisper android log)
target_link_options(kat_media PRIVATE "-Wl,--version-script=${CMAKE_CURRENT_LIST_DIR}/media-exports.map" "-Wl,-z,max-page-size=16384" "-Wl,--exclude-libs,ALL" "-Wl,--no-as-needed")
