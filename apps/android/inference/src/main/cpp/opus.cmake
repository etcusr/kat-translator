# Android adapter for the same pinned CTranslate2/SentencePiece and C ABI as Apple.
set(KAT_CT2_SOURCE "${KAT_ROOT}/Dependencies/vendor/CTranslate2")
set(KAT_SPM_SOURCE "${KAT_ROOT}/Dependencies/vendor/sentencepiece")
foreach(checkout "${KAT_CT2_SOURCE}" "${KAT_SPM_SOURCE}")
    if(NOT EXISTS "${checkout}/CMakeLists.txt")
        message(FATAL_ERROR "Run scripts/android/setup-opus.sh before building OPUS")
    endif()
endforeach()
execute_process(COMMAND git -C "${KAT_CT2_SOURCE}" rev-parse HEAD OUTPUT_VARIABLE KAT_CT2_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND git -C "${KAT_SPM_SOURCE}" rev-parse HEAD OUTPUT_VARIABLE KAT_SPM_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT KAT_CT2_COMMIT STREQUAL "617405f4b050e994e829d527da6caa0e0030afe7" OR NOT KAT_SPM_COMMIT STREQUAL "31646a467d2051eb904e0b45de3a73e91fe1c1e3")
    message(FATAL_ERROR "OPUS source revision differs from shared Apple pins")
endif()
file(READ "${KAT_CT2_SOURCE}/src/decoding.cc" KAT_CT2_DECODING)
if(NOT KAT_CT2_DECODING MATCHES "kat_opus_check_cancel")
    message(FATAL_ERROR "Run scripts/android/setup-opus.sh for cooperative decoding cancellation")
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_CLI OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
foreach(option WITH_MKL WITH_DNNL WITH_OPENBLAS WITH_ACCELERATE WITH_CUDA WITH_CUDNN WITH_TENSOR_PARALLEL WITH_FLASH_ATTN ENABLE_CPU_DISPATCH)
    set(${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(WITH_RUY ON CACHE BOOL "" FORCE)
set(OPENMP_RUNTIME NONE CACHE STRING "" FORCE)
set(RUY_MINIMAL_BUILD ON CACHE BOOL "" FORCE)
set(RUY_PROFILER OFF CACHE BOOL "" FORCE)
set(SPM_ENABLE_SHARED OFF CACHE BOOL "" FORCE)
set(SPM_ENABLE_TCMALLOC OFF CACHE BOOL "" FORCE)
set(SPM_BUILD_TEST OFF CACHE BOOL "" FORCE)
set(SPM_ENABLE_NFKC_COMPILE OFF CACHE BOOL "" FORCE)
foreach(option CPUINFO_BUILD_TOOLS CPUINFO_BUILD_UNIT_TESTS CPUINFO_BUILD_MOCK_TESTS CPUINFO_BUILD_BENCHMARKS)
    set(${option} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${KAT_CT2_SOURCE}" opus-ct2 EXCLUDE_FROM_ALL)
# Upstream unsets CMAKE_POSITION_INDEPENDENT_CODE after adding RUY. Static CT2
# still needs PIC because it is linked into JNI; otherwise ARM64 TLS becomes
# local-exec and cannot be relocated into libkat_opus.so.
set_target_properties(ctranslate2 PROPERTIES POSITION_INDEPENDENT_CODE ON)
# bionic has no pthread_setaffinity_np. Adapt only this build's translation unit;
# the shared Apple vendor checkout and its decoding patch remain untouched.
file(READ "${KAT_CT2_SOURCE}/src/thread_pool.cc" KAT_CT2_THREAD_POOL)
string(REPLACE "#if !defined(__linux__) || defined(_OPENMP)"
    "#if !defined(__linux__) || defined(__ANDROID__) || defined(_OPENMP)"
    KAT_CT2_ANDROID_THREAD_POOL "${KAT_CT2_THREAD_POOL}")
if(KAT_CT2_ANDROID_THREAD_POOL STREQUAL KAT_CT2_THREAD_POOL)
    message(FATAL_ERROR "Pinned CTranslate2 affinity guard changed; inspect Android adaptation")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/opus-thread-pool-android.cc" "${KAT_CT2_ANDROID_THREAD_POOL}")
get_target_property(KAT_CT2_SOURCES ctranslate2 SOURCES)
list(REMOVE_ITEM KAT_CT2_SOURCES "src/thread_pool.cc")
set_property(TARGET ctranslate2 PROPERTY SOURCES "${KAT_CT2_SOURCES};${CMAKE_CURRENT_BINARY_DIR}/opus-thread-pool-android.cc")
add_subdirectory("${KAT_SPM_SOURCE}" opus-sentencepiece EXCLUDE_FROM_ALL)
set_target_properties(sentencepiece-static PROPERTIES POSITION_INDEPENDENT_CODE ON)
add_library(kat_opus SHARED opus_jni.cpp "${KAT_ROOT}/shared/native/OpusRuntime/OpusRuntime.cpp")
target_include_directories(kat_opus PRIVATE "${KAT_ROOT}/shared/native/OpusRuntime" "${KAT_CT2_SOURCE}/include" "${KAT_CT2_SOURCE}/third_party" "${KAT_SPM_SOURCE}/src")
target_link_libraries(kat_opus PRIVATE ctranslate2 sentencepiece-static android log)
target_link_options(kat_opus PRIVATE "-Wl,--version-script=${CMAKE_CURRENT_LIST_DIR}/opus-exports.map" "-Wl,-z,max-page-size=16384" "-Wl,--exclude-libs,ALL")
