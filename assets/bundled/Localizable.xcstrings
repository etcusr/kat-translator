      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks system shortcuts and known browser and Telegram defaults. Custom shortcuts and extensions in other apps may require reassignment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяем системные и известные стандартные сочетания браузеров и Telegram. Пользовательские сочетания и расширения других приложений могут потребовать переназначения."
          }
