      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language counts are published by the model authors. This app offers %@ for the selected model; speech playback and camera recognition have separate limits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число языков заявлено авторами моделей. Для выбранной модели в приложении доступны %@; озвучка и камера имеют отдельные ограничения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los autores de los modelos publican el número de idiomas. Esta app ofrece %@ para el modelo elegido; la reproducción de voz y el reconocimiento con cámara tienen límites propios."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil sayılarını model geliştiricileri belirtir. Uygulama seçili model için %@ sunar; seslendirme ve kamerayla tanımanın sınırları ayrıdır."
          }
        }
      }
