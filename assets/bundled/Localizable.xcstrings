        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi'ye bağlanın veya mobil veriyi açın. Uygulamada izin vermek, kullanılamayan bir bağlantıyı geri getirmez."
          }
        }
      }
    },
